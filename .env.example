# ======================================
# Chanakya Unified Environment Variables
# ======================================

# ==================== API URLs ====================
# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:3000

# ==================== Sarvam AI Configuration ====================
# Get from: https://www.sarvam.ai/
SARVAM_API_KEY=servam-api-key
VITE_SARVAM_API_KEY=servam-api-key
VITE_SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
VITE_SARVAM_TTS_API_URL=https://api.sarvam.ai/text-to-speech

# ==================== Google Gemini API ====================
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=gemini-api-key
# Optional: model for PDF text/vision pipeline (default: gemini-2.0-flash-001)
GEMINI_PDF_MODEL=gemini-2.0-flash-001
# Optional: PDF compiler speed / rate-limit tuning
# Seconds between Gemini call batches (default 8). Use 2 for fast mode if you have higher Gemini quota.
PDF_COMPILER_DELAY_SEC=8
# Max concurrent Gemini calls during text/vision phase (default 2).
PDF_COMPILER_MAX_CONCURRENT=2
# Skip section consolidation for PDFs with this many pages or fewer (default 5). Saves Gemini calls for small docs.
PDF_COMPILER_SKIP_SECTION_PAGES=5

# ==================== PDF parsing (LlamaParse) ====================
# Required for PDF compiler. Get your API key from: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=your-llamaparse-api-key
# parsing tier. Options: fast, cost_effective, agentic, agentic_plus (default: fast)
LLAMAPARSE_TIER=agentic_plus

# ==================== MongoDB Configuration ====================
MONGODB_URL=mongo-url 
DATABASE_NAME=Chanakya

# ==================== JWT Configuration ====================
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_DAYS=7

# ==================== Environment ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== NLP Pipeline Configuration ====================
NLP_MIN_CONFIDENCE=0.3
NLP_CLARIFICATION_THRESHOLD=0.5
NLP_MAX_PROCESSING_TIME_MS=5000

# ==================== Audit Logging ====================
ENABLE_AUDIT_LOGGING=true
LOG_RAW_INPUT=true

# ==================== Twilio Configuration (Optional) ====================
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# ==================== Tavily API (Optional - for web search MCP) ====================
# Get from: https://www.tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# ==================== CORS Configuration ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000

# ==================== Query Cache Configuration ====================
QUERY_CACHE_ENABLED=true
QUERY_CACHE_MAX_SIZE=500
QUERY_CACHE_TTL_SECONDS=3600

# ==================== Tavily API Configuration ====================
TAVILY_API_KEY=